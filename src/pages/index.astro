---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import Pricing from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';
import DownloadCta from '../components/DownloadCta.astro';
import Footer from '../components/Footer.astro';
import { site, faqs, howItWorks } from '../data/site';

const title = `${site.name} — ${site.tagline}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: site.name,
    description: site.description,
    url: site.url,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'iOS, Android',
    inLanguage: 'vi',
    offers: [
      {
        '@type': 'Offer',
        name: 'Miễn phí',
        price: '0',
        priceCurrency: 'VND',
      },
    ],
    publisher: {
      '@type': 'Organization',
      name: site.name,
      url: site.url,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Cách Thuốc ơi tạo lịch nhắc uống thuốc từ ảnh đơn thuốc',
    step: howItWorks.map((item) => ({
      '@type': 'HowToStep',
      position: Number(item.step),
      name: item.title,
      text: item.body,
    })),
  },
];
---

<BaseLayout title={title} jsonLd={jsonLd}>
  <Header />
  <main id="noi-dung-chinh">
    <Hero />
    <TrustStrip />
    <HowItWorks />
    <Features />
    <Pricing />
    <FAQ />
    <DownloadCta />
  </main>
  <Footer />
</BaseLayout>
