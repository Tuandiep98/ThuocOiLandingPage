---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import Benefits from '../components/Benefits.astro';
import HowItWorks from '../components/HowItWorks.astro';
import NotificationsShowcase from '../components/NotificationsShowcase.astro';
import Features from '../components/Features.astro';
import Principles from '../components/Principles.astro';
import Pricing from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';
import DownloadCta from '../components/DownloadCta.astro';
import BlogTeaser from '../components/BlogTeaser.astro';
import Footer from '../components/Footer.astro';
import MobileDownloadBar from '../components/MobileDownloadBar.astro';
import { site, storeLinks, faqs, howItWorks, previewVideo } from '../data/site';
import { withBase } from '../lib/base';
import { videoJsonLd } from '../lib/seo';

const title = `${site.name} — ${site.tagline}`;

const logoURL = new URL(withBase('icon-512.png'), site.url).toString();

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: logoURL,
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  inLanguage: 'vi',
};

// Một entry riêng cho mỗi hệ điều hành: rich-result parser của Google chỉ nhận một giá trị
// operatingSystem đơn (vd. "IOS", "ANDROID"), không nhận chuỗi gộp "iOS, Android".
// Chưa có aggregateRating/review (app chưa có đánh giá thật) nên chưa đủ điều kiện rich result —
// xem "Known placeholders" trong CLAUDE.md, không bịa số liệu.
const mobileApplicationBase = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: site.name,
  description: site.description,
  url: site.url,
  applicationCategory: 'HealthApplication',
  inLanguage: 'vi',
  offers: [
    {
      '@type': 'Offer',
      name: 'Miễn phí',
      price: '0',
      priceCurrency: 'VND',
    },
  ],
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
};

const homeFaqs = faqs.slice(0, 4);

const jsonLd = [
  organization,
  website,
  {
    ...mobileApplicationBase,
    operatingSystem: 'IOS',
    downloadUrl: storeLinks.appStore,
  },
  {
    ...mobileApplicationBase,
    operatingSystem: 'ANDROID',
    downloadUrl: storeLinks.googlePlay,
  },
  videoJsonLd(previewVideo),
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Cách Thuốc ơi tạo lịch nhắc uống thuốc từ ảnh đơn thuốc',
    step: howItWorks.map((item) => ({
      '@type': 'HowToStep',
      position: Number(item.step),
      name: item.title,
      text: item.body,
    })),
  },
];
---

<BaseLayout title={title} jsonLd={jsonLd}>
  <Header />
  <main id="noi-dung-chinh">
    <Hero />
    <TrustStrip />
    <Benefits />
    <HowItWorks />
    <NotificationsShowcase />
    <Features />
    <Principles showMoreLink />
    <Pricing showMoreLink />
    <FAQ items={homeFaqs} moreLink />
    <DownloadCta />
    <BlogTeaser />
  </main>
  <Footer />
  <MobileDownloadBar />
</BaseLayout>
