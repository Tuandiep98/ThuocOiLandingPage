---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import Pricing from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';
import DownloadCta from '../components/DownloadCta.astro';
import BlogTeaser from '../components/BlogTeaser.astro';
import Footer from '../components/Footer.astro';
import { site, storeLinks, faqs, howItWorks } from '../data/site';

const title = `${site.name} — ${site.tagline}`;

// Base path-aware vì build GitHub Pages phục vụ dưới /ThuocOiLandingPage/ (xem astro.config.mjs).
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const logoURL = new URL(`${base}icon-512.png`, site.url).toString();

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  logo: logoURL,
};

// Một entry riêng cho mỗi hệ điều hành: rich-result parser của Google chỉ nhận một giá trị
// operatingSystem đơn (vd. "IOS", "ANDROID"), không nhận chuỗi gộp "iOS, Android".
const mobileApplicationBase = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: site.name,
  description: site.description,
  url: site.url,
  applicationCategory: 'HealthApplication',
  inLanguage: 'vi',
  offers: [
    {
      '@type': 'Offer',
      name: 'Miễn phí',
      price: '0',
      priceCurrency: 'VND',
    },
  ],
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
  },
};

const jsonLd = [
  organization,
  {
    ...mobileApplicationBase,
    operatingSystem: 'IOS',
    downloadUrl: storeLinks.appStore,
  },
  {
    ...mobileApplicationBase,
    operatingSystem: 'ANDROID',
    downloadUrl: storeLinks.googlePlay,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: 'Cách Thuốc ơi tạo lịch nhắc uống thuốc từ ảnh đơn thuốc',
    step: howItWorks.map((item) => ({
      '@type': 'HowToStep',
      position: Number(item.step),
      name: item.title,
      text: item.body,
    })),
  },
];
---

<BaseLayout title={title} jsonLd={jsonLd}>
  <Header />
  <main id="noi-dung-chinh">
    <Hero />
    <TrustStrip />
    <HowItWorks />
    <Features />
    <Pricing />
    <FAQ />
    <DownloadCta />
    <BlogTeaser />
  </main>
  <Footer />
</BaseLayout>
