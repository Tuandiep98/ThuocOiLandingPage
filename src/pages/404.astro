---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { featurePages, featureHref } from '../data/site';
import { withBase } from '../lib/base';

// Trang 404 dẫn người đọc tới các trang có ích thay vì chỉ một nút về trang chủ.
const links = [
  ...featurePages.map((page) => ({ href: featureHref(page.slug), title: page.navLabel, body: page.eyebrow })),
  { href: 'cau-hoi-thuong-gap/', title: 'Câu hỏi thường gặp', body: 'Giải đáp trước khi cài ứng dụng' },
  { href: 'blog/', title: 'Blog', body: 'Hỏi đáp về dùng thuốc đúng cách' },
];
---

<BaseLayout
  title="Không tìm thấy trang — Thuốc ơi"
  description="Trang bạn tìm không tồn tại hoặc đã được chuyển."
  noindex
>
  <Header />
  <main id="noi-dung-chinh">
    <section class="section">
      <div class="wrap not-found">
        <p class="code" aria-hidden="true">404</p>
        <h1>Không tìm thấy trang này</h1>
        <p class="lead">Có thể đường dẫn đã đổi hoặc gõ chưa đúng. Bạn có thể bắt đầu từ một trong những trang dưới đây.</p>
        <a class="btn btn-primary" href={withBase('')}>Về trang chủ</a>
        <ul class="links">
          {
            links.map((link) => (
              <li>
                <a href={withBase(link.href)}>
                  <span class="title">{link.title}</span>
                  <span class="body">{link.body}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    max-width: 48rem;
  }

  .code {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4rem, 3rem + 6vw, 7rem);
    line-height: 1;
    color: var(--leaf);
  }

  h1 {
    margin-top: var(--space-2);
    font-size: var(--fs-h2);
  }

  .lead {
    margin: var(--space-2) auto var(--space-4);
    color: var(--ink-soft);
    font-size: var(--fs-lead);
    max-width: 34rem;
  }

  .links {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    text-align: left;
  }

  .links a {
    display: block;
    height: 100%;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-raised);
    text-decoration: none;
  }

  .links a:hover {
    border-color: var(--leaf);
  }

  .title {
    display: block;
    font-weight: 700;
    color: var(--pine);
  }

  .body {
    display: block;
    margin-top: 0.2rem;
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }
</style>
