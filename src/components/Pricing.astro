---
import { plans } from '../data/site';
---

<section class="section" id="bang-gia" aria-labelledby="pricing-heading">
  <div class="wrap">
    <div class="section-head">
      <h2 id="pricing-heading">Một gói phù hợp với cách bạn dùng thuốc</h2>
      <p>Nhắc thuốc, báo thức và lịch sử bạn đang có sẽ không bao giờ bị thu phí lại — nâng gói chỉ để quét đơn bằng AI nhiều hơn và thêm người trong gia đình.</p>
    </div>

    <div class="plans">
      {
        plans.map((plan) => (
          <article class={`plan ${plan.highlight ? 'highlight' : ''}`}>
            <h3>{plan.name}</h3>
            <p class="price">
              {plan.price || plan.priceNote}
            </p>
            <p class="desc">{plan.description}</p>
            <ul>
              {plan.benefits.map((benefit) => (
                <li>{benefit}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .plans {
    display: grid;
    gap: var(--space-3);
  }

  .plan {
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    background: var(--paper-raised);
  }

  .plan h3 {
    font-size: 1.375rem;
  }

  .price {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    color: var(--leaf-deep);
  }

  .plan.highlight .price {
    color: var(--leaf);
  }

  .desc {
    margin-top: var(--space-2);
    color: var(--ink-soft);
    font-size: var(--fs-small);
  }

  .plan ul {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .plan li {
    padding-left: 1.5rem;
    position: relative;
    font-size: var(--fs-small);
  }

  .plan li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.45rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--leaf-deep);
  }

  .plan.highlight {
    background: var(--pine);
    border-color: var(--pine);
    color: white;
  }

  .plan.highlight h3,
  .plan.highlight .desc {
    color: white;
  }

  .plan.highlight .desc {
    opacity: 0.85;
  }

  .plan.highlight li::before {
    background: var(--leaf);
  }

  @media (min-width: 56rem) {
    .plans {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }

    .plan.highlight {
      transform: translateY(-0.75rem);
      box-shadow: var(--shadow-soft);
    }
  }
</style>
