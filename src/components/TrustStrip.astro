---
import { trustPoints } from '../data/site';
---

<section class="trust" aria-label="Cam kết của Thuốc ơi">
  <div class="wrap grid">
    {
      trustPoints.map((point) => (
        <div class="item">
          <p class="item-title">{point.title}</p>
          <p>{point.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .trust {
    padding-block: var(--space-4);
    border-block: 1px solid var(--line);
    background: var(--paper-raised);
  }

  .grid {
    display: grid;
    gap: var(--space-3);
  }

  .item {
    padding-top: var(--space-2);
    border-top: 3px solid var(--leaf);
  }

  .item-title {
    font-size: 1.0625rem;
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--pine);
  }

  .item p {
    margin-top: 0.4rem;
    color: var(--ink-soft);
    font-size: var(--fs-small);
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
    }
  }
</style>
