---
import { getCollection } from 'astro:content';
import { withBase } from '../lib/base';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
---

{
  posts.length > 0 && (
    // h3 chứ không phải h2 thứ 5: trang chủ cố tình chỉ có 4 h2 (How it works/Features/Pricing/
    // FAQ) cho SEO/AI-parsing (xem CLAUDE.md) — khối này là "further reading" phụ trợ, không phải
    // một section nội dung chính ngang hàng 4 section kia.
    <section class="blog-teaser" aria-labelledby="blog-teaser-heading">
      <div class="wrap">
        <div class="teaser-head">
          <h3 id="blog-teaser-heading">Bài viết mới</h3>
          <a class="see-all" href={withBase('blog/')}>
            Xem tất cả bài viết
          </a>
        </div>
        <ul class="teaser-list">
          {posts.map((post) => (
            <li>
              <a href={withBase(`blog/${post.id}/`)}>
                <span class="eyebrow">{post.data.segment}</span>
                <span class="post-title">{post.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .blog-teaser {
    padding-block: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .teaser-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .teaser-head h3 {
    font-size: var(--fs-h3);
  }

  .see-all {
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--pine);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    white-space: nowrap;
  }

  .see-all:hover {
    border-color: var(--pine);
  }

  .teaser-list {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  @media (min-width: 56rem) {
    .teaser-list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-3);
    }
  }

  .teaser-list a {
    display: block;
    height: 100%;
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper-raised);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .teaser-list a:hover {
    border-color: var(--leaf);
    transform: translateY(-2px);
  }

  .teaser-list .eyebrow {
    display: block;
    color: var(--leaf-deep);
    font-weight: 700;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .teaser-list .post-title {
    display: block;
    margin-top: 0.35rem;
    color: var(--pine);
    font-weight: 600;
    line-height: 1.35;
  }
</style>
