---
import { storeLinks } from '../data/site';

// Thanh tải app dính đáy màn hình, chỉ hiện trên điện thoại (dưới 48rem). Thuần CSS
// (position: sticky ở cuối <body>) — không JS, không che nội dung khi cuộn hết trang.
---

<aside class="download-bar" aria-label="Tải ứng dụng">
  <p>Tải Thuốc ơi <span>miễn phí</span></p>
  <a class="pill" href={storeLinks.appStore}>App Store</a>
  <a class="pill" href={storeLinks.googlePlay}>Google Play</a>
</aside>

<style>
  .download-bar {
    position: sticky;
    bottom: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem calc(0.6rem + env(safe-area-inset-bottom));
    background: rgba(14, 59, 46, 0.96);
    backdrop-filter: blur(8px);
    color: white;
  }

  p {
    flex: 1;
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.2;
  }

  p span {
    display: block;
    font-weight: 400;
    font-size: 0.8125rem;
    color: #cfebd9;
  }

  .pill {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding: 0 0.9rem;
    border-radius: var(--radius-pill);
    background: var(--leaf);
    color: var(--pine);
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .pill + .pill {
    background: white;
  }

  @media (min-width: 48rem) {
    .download-bar {
      display: none;
    }
  }
</style>
