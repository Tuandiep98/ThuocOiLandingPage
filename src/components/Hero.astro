---
import AppVideo from './AppVideo.astro';
import StoreButtons from './StoreButtons.astro';
import { previewVideo } from '../data/site';
---

<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="copy">
      <p class="eyebrow">Ứng dụng nhắc uống thuốc · iOS & Android</p>
      <h1>Một tấm ảnh đơn thuốc, cả nhà biết khi nào uống thuốc</h1>
      <p class="lead">
        Thuốc ơi đọc đơn thuốc bằng AI, tự xếp lịch nhắc theo từng buổi sáng, trưa, tối và nhắc đúng
        giờ — kể cả khi điện thoại đang im lặng. Người thân được báo nếu có liều bị lỡ.
      </p>
      <StoreButtons />
      <ul class="facts">
        <li>Miễn phí nhắc thuốc không giới hạn</li>
        <li>Nhắc không cần mạng</li>
        <li>Không quảng cáo</li>
      </ul>
    </div>

    <div class="art">
      <AppVideo
        mp4={previewVideo.mp4}
        poster={previewVideo.poster}
        width={previewVideo.width}
        height={previewVideo.height}
        label="Video 13 giây: lịch nhắc theo buổi, thông báo Đến giờ uống thuốc với nút Đã uống, cảnh báo người thân khi lỡ liều và báo thức khi iPhone im lặng"
        eager
        class="hero-video"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-4) var(--space-5);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }

  .eyebrow {
    display: inline-block;
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--leaf-deep);
    background: var(--leaf-tint);
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-2);
  }

  .copy h1 {
    font-size: var(--fs-h1);
  }

  .lead {
    margin-block: var(--space-3) var(--space-4);
    font-size: var(--fs-lead);
    color: var(--ink-soft);
    max-width: 34rem;
  }

  .facts {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    font-size: var(--fs-small);
    color: var(--ink-soft);
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .facts li::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--leaf);
  }

  .art {
    display: flex;
    justify-content: center;
  }

  .hero-video {
    max-width: 26rem;
  }

  @media (min-width: 48rem) and (max-width: 63.99rem) {
    /* tablet: video nhỏ lại để chữ và nút tải vẫn nằm trong màn hình đầu tiên */
    .hero-video {
      max-width: 22rem;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      padding-block: var(--space-5) var(--space-6);
    }

    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--space-5);
    }

    .art {
      justify-content: flex-end;
    }
  }
</style>
