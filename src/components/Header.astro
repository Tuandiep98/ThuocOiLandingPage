---
import { Image } from 'astro:assets';
import icon from '../assets/brand/icon_light.png';
import { site, storeLinks } from '../data/site';

const links = [
  { href: '#tinh-nang', label: 'Tính năng' },
  { href: '#cach-hoat-dong', label: 'Cách hoạt động' },
  { href: '#bang-gia', label: 'Bảng giá' },
  { href: '#cau-hoi', label: 'Câu hỏi thường gặp' },
];
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="#top">
      <Image src={icon} alt="" width={80} height={80} loading="eager" class="brand-icon" />
      <span>{site.name}</span>
    </a>
    <nav class="links" aria-label="Điều hướng chính">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a class="btn btn-primary cta" href={storeLinks.appStore}>Tải ứng dụng</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(246, 249, 242, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: 0.9rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--pine);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .brand-icon {
    width: 40px;
    height: 40px;
    border-radius: 9px;
  }

  .links {
    display: none;
    gap: var(--space-3);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .links a {
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }

  .links a:hover {
    color: var(--pine);
    border-color: var(--leaf);
  }

  .cta {
    padding: 0.65rem 1.1rem;
    font-size: 0.9375rem;
    flex-shrink: 0;
  }

  @media (min-width: 64rem) {
    .links {
      display: flex;
    }
  }
</style>
