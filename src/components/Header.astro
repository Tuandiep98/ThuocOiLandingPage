---
import { Image } from 'astro:assets';
import icon from '../assets/brand/icon_light.png';
import { site, storeLinks } from '../data/site';
import { withBase } from '../lib/base';

// Mọi link là trang thật (không phải anchor) — mỗi mục có URL riêng để index/chia sẻ được.
// Menu điện thoại/tablet dùng <details> gốc của trình duyệt, không cần JS.
const links = [
  { href: withBase('tinh-nang/'), label: 'Tính năng', match: 'tinh-nang' },
  { href: withBase('bang-gia/'), label: 'Bảng giá', match: 'bang-gia' },
  { href: withBase('gioi-thieu/'), label: 'Giới thiệu', match: 'gioi-thieu' },
  { href: withBase('cau-hoi-thuong-gap/'), label: 'Hỏi đáp', match: 'cau-hoi-thuong-gap' },
  { href: withBase('blog/'), label: 'Blog', match: 'blog' },
];

const path = Astro.url.pathname;
const isCurrent = (match: string) => path.includes(`/${match}/`);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={withBase('')}>
      <Image src={icon} alt="" width={80} height={80} loading="eager" class="brand-icon" />
      <span>{site.name}</span>
    </a>
    <nav class="links" aria-label="Điều hướng chính">
      {
        links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.match) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="actions">
      <a class="btn btn-primary cta" href={storeLinks.appStore}>Tải ứng dụng</a>
      <details class="menu">
        <summary aria-label="Mở menu">
          <span class="bars" aria-hidden="true"></span>
        </summary>
        <nav class="menu-panel" aria-label="Điều hướng chính (di động)">
          {
            links.map((link) => (
              <a href={link.href} aria-current={isCurrent(link.match) ? 'page' : undefined}>
                {link.label}
              </a>
            ))
          }
          <a href={storeLinks.googlePlay}>Tải trên Google Play</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(246, 249, 242, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: 0.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--pine);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .brand-icon {
    width: 40px;
    height: 40px;
    border-radius: 9px;
  }

  .links {
    display: none;
    gap: var(--space-3);
    font-weight: 600;
    color: var(--ink-soft);
  }

  .links a {
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }

  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--pine);
    border-color: var(--leaf);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cta {
    padding: 0.65rem 1.1rem;
    font-size: 0.9375rem;
    flex-shrink: 0;
  }

  .menu {
    position: relative;
  }

  .menu summary {
    list-style: none;
    cursor: pointer;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line-strong);
    background: var(--paper-raised);
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: var(--pine);
    border-radius: 2px;
    transition: transform 0.15s ease;
  }

  .bars {
    position: relative;
  }

  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .bars::before {
    top: -6px;
  }

  .bars::after {
    top: 6px;
  }

  .menu[open] .bars {
    background: transparent;
  }

  .menu[open] .bars::before {
    transform: translateY(6px) rotate(45deg);
  }

  .menu[open] .bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    width: min(18rem, calc(100vw - 2rem));
    display: grid;
    padding: 0.5rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-soft);
  }

  .menu-panel a {
    padding: 0.8rem 0.9rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 600;
    color: var(--pine);
  }

  .menu-panel a:hover,
  .menu-panel a[aria-current='page'] {
    background: var(--leaf-tint);
  }

  @media (max-width: 23rem) {
    .cta {
      display: none;
    }
  }

  @media (min-width: 64rem) {
    .links {
      display: flex;
    }

    .menu {
      display: none;
    }
  }
</style>
