---
import StoreButtons from './StoreButtons.astro';

interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = 'Sẵn sàng bỏ nỗi lo quên liều thuốc?',
  body = 'Chụp đơn thuốc đầu tiên hôm nay — phần nhắc thuốc cốt lõi luôn miễn phí.',
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-heading">
  <div class="wrap inner">
    <h2 id="cta-heading">{heading}</h2>
    <p>{body}</p>
    <StoreButtons tone="dark" center />
  </div>
</section>

<style>
  .cta-band {
    background: linear-gradient(165deg, var(--pine) 0%, #0a2820 100%);
    color: white;
    padding-block: var(--space-6);
  }

  .inner {
    text-align: center;
    max-width: 36rem;
  }

  .inner h2 {
    color: white;
    font-size: var(--fs-h2);
  }

  .inner p {
    margin-block: var(--space-2) var(--space-4);
    font-size: var(--fs-lead);
    color: #cfebd9;
  }
</style>
