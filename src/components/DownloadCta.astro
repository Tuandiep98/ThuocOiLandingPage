---
import { storeLinks } from '../data/site';
---

<section class="cta-band" aria-labelledby="cta-heading">
  <div class="wrap inner">
    <h2 id="cta-heading">Sẵn sàng bỏ nỗi lo quên liều thuốc?</h2>
    <p>Chụp đơn thuốc đầu tiên hôm nay — phần nhắc thuốc cốt lõi luôn miễn phí.</p>
    <div class="cta-row">
      <a class="btn btn-on-dark" href={storeLinks.appStore}>Tải trên App Store</a>
      <a class="btn btn-ghost on-dark" href={storeLinks.googlePlay}>Tải trên Google Play</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: linear-gradient(165deg, var(--pine) 0%, #0a2820 100%);
    color: white;
    padding-block: var(--space-6);
  }

  .inner {
    text-align: center;
    max-width: 36rem;
  }

  .inner h2 {
    color: white;
  }

  .inner p {
    margin-top: var(--space-2);
    font-size: var(--fs-lead);
    color: #cfebd9;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: var(--space-4);
  }

  .btn-ghost.on-dark {
    border-color: rgba(255, 255, 255, 0.4);
    color: white;
  }

  .btn-ghost.on-dark:hover {
    border-color: white;
    background: rgba(255, 255, 255, 0.08);
  }
</style>
