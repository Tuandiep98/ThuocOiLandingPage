---
import '../styles/global.css';
import { site, storeLinks } from '../data/site';
import { withBase } from '../lib/base';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description = site.description, jsonLd = [], noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(withBase('og-image.png'), Astro.site);
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/png" sizes="32x32" href={withBase('favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={withBase('favicon-16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase('apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('site.webmanifest')} />
    <meta name="theme-color" content="#0e3b2e" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={`${site.name} — ${site.tagline}`} />

    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="format-detection" content="telephone=no" />

    <!-- Banner gợi ý tải app ngay trên trình duyệt: Safari (iOS) + Chrome (Android) -->
    <meta name="apple-itunes-app" content={`app-id=${storeLinks.appStoreId}`} />
    <meta name="google-play-app" content={`app-id=${storeLinks.androidPackageId}`} />

    {
      jsonLd.map((entry) => (
        <script type="application/ld+json" set:html={JSON.stringify(entry)} is:inline />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#noi-dung-chinh">Bỏ qua, đến nội dung chính</a>
    <slot />
  </body>
</html>
