---
import '../styles/global.css';
import { site, storeLinks } from '../data/site';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown>[];
}

const { title, description = site.description, jsonLd = [] } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// import.meta.env.BASE_URL không tự đảm bảo có dấu "/" cuối (phụ thuộc giá trị `base` truyền
// vào astro.config.mjs) — tự chuẩn hoá ở đây để nối path tĩnh không bị dính chữ (từng gây lỗi
// 404 thật trên bản GitHub Pages: "...LandingPagefavicon-32.png" thay vì có dấu "/").
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const ogImageURL = new URL(`${base}og-image.png`, Astro.site);
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta name="theme-color" content="#0e3b2e" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <meta name="robots" content="index, follow" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Banner gợi ý tải app ngay trên trình duyệt: Safari (iOS) + Chrome (Android) -->
    <meta name="apple-itunes-app" content={`app-id=${storeLinks.appStoreId}`} />
    <meta name="google-play-app" content={`app-id=${storeLinks.androidPackageId}`} />

    {
      jsonLd.map((entry) => (
        <script type="application/ld+json" set:html={JSON.stringify(entry)} is:inline />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#noi-dung-chinh">Bỏ qua, đến nội dung chính</a>
    <slot />
  </body>
</html>
