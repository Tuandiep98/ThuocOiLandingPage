# Build-time-only, đọc bởi src/content.config.ts (collection legalDocuments) để fetch nội
# dung Privacy Policy/Terms of Service từ Supabase lúc build. Không có prefix PUBLIC_/VITE_ —
# không được lộ ra client bundle, vì không có JS phía client nào cần đến giá trị này.
# Anon key chỉ có quyền SELECT trên view legal_document_current (đã lọc RLS chỉ bản published
# hiện hành) — không phải secret đặc quyền, nhưng vẫn không commit vào git.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
